# ===========================================
# GoTo3D Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values

# -------------------------------------------
# Supabase Configuration
# -------------------------------------------
# Your Supabase project URL (from Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase anon/public key (from Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase project reference (for CLI/scripts)
PROJECT_REF=your-project-ref

# -------------------------------------------
# Cloudflare R2 Storage Configuration
# -------------------------------------------
# Your Cloudflare account ID
NEXT_CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id

# R2 access key ID (from R2 > Manage API Tokens)
NEXT_CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id

# R2 secret access key
NEXT_CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# R2 bucket name for private files (models, images)
NEXT_CLOUDFLARE_R2_BUCKET_NAME=your-private-bucket-name

# R2 bucket name for public files (thumbnails)
NEXT_CLOUDFLARE_R2_BUCKET_PUBLIC_NAME=your-public-bucket-name

# -------------------------------------------
# RabbitMQ Queue Configuration
# -------------------------------------------
# AMQP connection string for RabbitMQ
# Format: amqp://username:password@host:port
QUEUE_CONNECTION_STRING=amqp://localhost

# Queue name for processing jobs
QUEUE_NAME=processing-dev

# -------------------------------------------
# Upstash Redis (Rate Limiting)
# -------------------------------------------
# Create a free Redis database at https://console.upstash.com
# From the database dashboard: REST API > REST URL and REST Token
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# -------------------------------------------
# Site Configuration
# -------------------------------------------
# Your site URL (without protocol, used for metadata)
SITE_URL=localhost:8080
